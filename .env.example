# =============================================
# Telegram Student Result Management System
# Environment Configuration Example
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---------------------------
# Telegram Bot
# ---------------------------
BOT_TOKEN=your_telegram_bot_token_here

# ---------------------------
# Database
# ---------------------------
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/student_results

# For Docker Compose, use the service name:
# DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/student_results

# ---------------------------
# Application
# ---------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------------------------
# Admin Bootstrap
# Comma-separated Telegram user IDs that will be
# treated as administrators on first startup.
# Get your Telegram user ID from @userinfobot
# ---------------------------
ADMIN_TELEGRAM_IDS=123456789,987654321

# ---------------------------
# Security
# ---------------------------
# Maximum photo size in MB (default: 10)
MAX_PHOTO_SIZE_MB=10

# Rate limiting: max requests per minute per user
RATE_LIMIT_PER_MINUTE=20

# ---------------------------
# Student Privacy Mode
# "linked"  - students must have their Telegram ID linked by admin (recommended)
# "open"    - students can look up results by ID only (less secure)
# ---------------------------
STUDENT_LOOKUP_MODE=linked
